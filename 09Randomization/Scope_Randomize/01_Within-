    repeat(3)
      begin

        std :: randomize(a);
        $display("The value of a is =%0d", a);
        
        std :: randomize(b) with {b>4;};
        $display("The value of b is =%0d",b);
    
        std :: randomize(a,b);
        $display("The value of a=%0d and b=%0d",a,b);
    
        std :: randomize(c,d) with { c>5; d>8;};
        $display("The value of c =%0d and d =%0d",c,d);
        #10;
        
        
      end
  end
  
endmodule
    
    
